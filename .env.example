# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# Comma-separated emails that hold the admin role. The account must already
# exist in Firebase Authentication; this list only grants the role.
ADMIN_EMAILS=admin@internshield.local

# Standard administrator sign-in (no single sign-on / no fast-pass).
# Set ADMIN_PASSWORD to enable it. Leave blank to disable and rely on Firebase.
ADMIN_EMAIL=admin@internshield.local
ADMIN_PASSWORD=Admin@12345

# Optional but recommended: store a PBKDF2 hash instead of the plain password.
# Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('ADMIN_PASSWORD_SALT='+s);console.log('ADMIN_PASSWORD_HASH='+c.pbkdf2Sync('your-password',s,210000,32,'sha256').toString('hex'))"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# Firebase Web App config (public identifiers; copy into public/js/firebase-config.js)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Optional (only if you add Gemini on the backend)
GEMINI_API_KEY=
